# Frontend (Vite) — point at your own Supabase project
VITE_SUPABASE_URL=https://<your-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your anon / publishable key>
VITE_SUPABASE_PROJECT_ID=<your-ref>
VITE_RAZORPAY_KEY_ID=<your Razorpay key id>

# Canonical origin used for SEO canonicals and Open Graph URLs.
# Falls back to window.location.origin at runtime when unset.
VITE_SITE_URL=https://consciousos.app

# Release label surfaced in observability events.
VITE_APP_VERSION=dev

# Which brain composes sittings.
#   local  -> deterministic engine only (no LLM, no credits)
#   hybrid -> local plan is authoritative; paid AI only on explicit "deep" request (default)
#   cloud  -> paid edge composer first, deterministic fallback
VITE_AI_BRAIN_MODE=hybrid

# AI Gateway URL (for orchestrator health checks)
AI_GATEWAY_URL=https://<your-ai-gateway>.supabase.co/functions/v1

# ---------------------------------------------------------------------------
# Edge function secrets — set with: supabase secrets set NAME=value
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected)
# ---------------------------------------------------------------------------

# AI providers (at least one required)
GROQ_API_KEY=
GEMINI_API_KEY=

# Voice / speech
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_MODE=test

# Scheduled jobs
CRON_SECRET=

# Optional integrations
GITHUB_TOKEN=
GOOGLE_CALENDAR_API_KEY=
GOOGLE_MAIL_API_KEY=
MICROSOFT_OUTLOOK_API_KEY=
MICROSOFT_TEAMS_API_KEY=
SLACK_API_KEY=
LINEAR_API_KEY=
